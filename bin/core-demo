require dirname(__DIR__) . '/vendor/autoload.php';

/**
 * @param array<string, string> $headers
 */
final class DemoRejectingQueue implements JobQueue
{
	public function push(string $type, array $payload, ?\DateTimeImmutable $availableAt = null): Job
	{
		throw new RuntimeException('The demo delivery queue is unavailable.');
	}

	public function reserve(int $limit, \DateTimeImmutable $now): array
	{
		return [];
	}

	public function complete(Job $job): void
	{
	}

	public function fail(Job $job, \Throwable $error, \DateTimeImmutable $now): void
	{
	}

	public function deadLetter(Job $job, \Throwable $error, \DateTimeImmutable $now): void
	{
	}

	public function pendingCount(): int
	{
		return 0;
	}

	public function deadLetterCount(): int
	{
		return 0;
	}
}

function call(Application $app, string $label, Request $request): Response
{
	$response = $app->handle($request);

	printf("%s -> %d %s\n", $label, $response->status, $response->status < 400 ? 'ok' : 'error');

	try {
		$decoded = $response->decodedBody();
	} catch (JsonException) {
		$decoded = $response->body;
	}

	if ($decoded !== null) {
		echo json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
	}

	echo "\n";

	return $response;
}

$app = Application::inMemory(
	localActors: new InMemoryActorDirectory(['alice', 'bob']),
);

echo "Aloha Social core — in-memory reference assembly\n";
echo "Routes: ", count($app->routes->routes()), ", queued jobs: ", $app->queue->pendingCount(), "\n\n";

call($app, 'GET /healthz', new Request('GET', '/healthz'));

call(
	$app,
	'POST /api/v1/posts (alice)',
	new Request(
		method: 'POST',
		path: '/api/v1/posts',
		headers: ['Content-Type' => 'application/json'],
		body: json_encode([
			'content' => 'Hello from the Aloha Social core.',
			'visibility' => 'public',
		], JSON_THROW_ON_ERROR),
		userId: 'alice',
	),
);

call(
	$app,
	'POST /api/v1/posts (anonymous)',
	new Request(
		method: 'POST',
		path: '/api/v1/posts',
		body: '{"content":"should be refused"}',
	),
);

call(
	$app,
	'POST /api/v1/posts (hashtag)',
	new Request(
		method: 'POST',
		path: '/api/v1/posts',
		headers: ['Content-Type' => 'application/json'],
		body: json_encode([
			'content' => 'A post for #demo and #release.',
			'visibility' => 'public',
		], JSON_THROW_ON_ERROR),
		userId: 'alice',
	),
);

call($app, 'GET /api/v1/timelines/public', new Request('GET', '/api/v1/timelines/public'));
call($app, 'GET /api/v1/timelines/tag/demo', new Request('GET', '/api/v1/timelines/tag/demo'));

call(
	$app,
	'POST /api/v1/followed_tags (alice)',
	new Request(
		method: 'POST',
		path: '/api/v1/followed_tags',
		headers: ['Content-Type' => 'application/json'],
		body: json_encode(['tag' => '#demo'], JSON_THROW_ON_ERROR),
		userId: 'alice',
	),
);
call($app, 'GET /api/v1/followed_tags (alice)', new Request('GET', '/api/v1/followed_tags', userId: 'alice'));
$followedTimeline = call(
	$app,
	'GET /api/v1/timelines/followed_tags (alice)',
	new Request('GET', '/api/v1/timelines/followed_tags', userId: 'alice'),
);
call(
	$app,
	'DELETE /api/v1/followed_tags/demo (alice)',
	new Request('DELETE', '/api/v1/followed_tags/demo', userId: 'alice'),
);

call($app, 'GET /api/v1/timelines/home (bob)', new Request('GET', '/api/v1/timelines/home', userId: 'bob'));

call(
	$app,
	'POST /api/v1/followers (alice)',
	new Request(
		method: 'POST',
		path: '/api/v1/followers',
		headers: ['Content-Type' => 'application/json'],
		body: json_encode([
			'actor' => 'https://remote.example/users/bob',
			'inbox' => 'https://remote.example/users/bob/inbox',
		], JSON_THROW_ON_ERROR),
		userId: 'alice',
	),
);

call($app, 'GET /api/v1/followers (alice)', new Request('GET', '/api/v1/followers', userId: 'alice'));

call($app, 'GET /api/v1/accounts/bob', new Request('GET', '/api/v1/accounts/bob'));
call(
	$app,
	'POST /api/v1/accounts/bob/follow (alice)',
	new Request('POST', '/api/v1/accounts/bob/follow', userId: 'alice'),
);
call(
	$app,
	'GET /api/v1/accounts/bob (as alice)',
	new Request('GET', '/api/v1/accounts/bob', userId: 'alice'),
);
call($app, 'GET /api/v1/notifications (bob)', new Request('GET', '/api/v1/notifications', userId: 'bob'));
call(
	$app,
	'GET /api/v1/notifications/unread_count (bob)',
	new Request('GET', '/api/v1/notifications/unread_count', userId: 'bob'),
);

call(
	$app,
	'POST /api/v1/following (not configured)',
	new Request(
		method: 'POST',
		path: '/api/v1/following',
		headers: ['Content-Type' => 'application/json'],
		body: json_encode([
			'actor' => 'https://remote.example/users/bob',
			'inbox' => 'https://remote.example/users/bob/inbox',
		], JSON_THROW_ON_ERROR),
		userId: 'alice',
	),
);

// No signing key, no actor directory: the document routes say so instead of
// publishing an actor whose key and inbox nobody could use.
call($app, 'GET /@alice (not configured)', new Request('GET', '/@alice'));
call($app, 'GET /@alice/followers (not configured)', new Request('GET', '/@alice/followers'));
call($app, 'GET /@alice/following (not configured)', new Request('GET', '/@alice/following'));
call($app, 'GET /@alice/outbox (not configured)', new Request('GET', '/@alice/outbox'));
call(
	$app,
	'GET /.well-known/webfinger (not configured)',
	new Request('GET', '/.well-known/webfinger', ['resource' => 'acct:alice@localhost:8080']),
);

// No actor resolver and no signing key in the reference assembly: the inbox
// says so instead of accepting activities it could neither verify nor answer.
call(
	$app,
	'POST /inbox (not configured)',
	new Request(
		method: 'POST',
		path: '/inbox',
		body: '{"type":"Follow"}',
	),
);

call($app, 'POST /api/v1/posts (invalid)', new Request(
	method: 'POST',
	path: '/api/v1/posts',
	body: '{"content":"   "}',
	userId: 'alice',
));

call($app, 'GET /api/v1/nope', new Request('GET', '/api/v1/nope'));

$response = $app->handle(new Request('GET', '/api/v1/timelines/public'));
assert($response instanceof Response);

$body = $response->decodedBody();
$posts = is_array($body) ? ($body['posts'] ?? []) : [];
if (!is_array($posts) || $posts === []) {
	fwrite(STDERR, "demo failed: the post that was just written is not in the timeline\n");
	exit(1);
}

$followedBody = $followedTimeline->decodedBody();
$followedPosts = is_array($followedBody) ? ($followedBody['posts'] ?? []) : [];
if (!is_array($followedPosts) || $followedPosts === []) {
	fwrite(STDERR, "demo failed: the followed hashtag timeline is empty\n");
	exit(1);
}

// Cleanup is a worker operation: seed old and fresh rows, preview the cutoff,
// enqueue the real job and prove that only the expired rows disappeared.
$cleanupClock = new FrozenClock(Time::parse('2026-03-02T00:00:00Z'));
$cleanupBlobs = new InMemoryBlobStore();
$cleanupPosts = new InMemoryPostRepository();
$cleanupRemotePosts = new InMemoryRemotePostRepository();
$cleanupAttachments = new InMemoryAttachmentRepository($cleanupPosts, $cleanupRemotePosts);
$cleanupNotifications = new InMemoryNotificationRepository();
$cleanupThreads = new InMemoryRemoteThreadRepository();

$oldAttachment = new Attachment(
	id: 'cleanup-old',
	ownerId: 'alice',
	storageKey: 'media/cleanup-old/original.png',
	thumbnailKey: 'media/cleanup-old/thumbnail.png',
	mimeType: 'image/png',
	width: 800,
	height: 600,
	byteSize: 1234,
	altText: null,
	createdAt: Time::parse('2026-01-01T00:00:00Z'),
);
$linkedAttachment = new Attachment(
	id: 'cleanup-linked',
	ownerId: 'alice',
	storageKey: 'media/cleanup-linked/original.png',
	thumbnailKey: 'media/cleanup-linked/thumbnail.png',
	mimeType: 'image/png',
	width: 800,
	height: 600,
	byteSize: 1234,
	altText: null,
	createdAt: Time::parse('2026-01-01T00:00:00Z'),
);
$remoteLinkedAttachment = new Attachment(
	id: 'cleanup-remote-linked',
	ownerId: 'alice',
	storageKey: 'media/cleanup-remote-linked/original.png',
	thumbnailKey: 'media/cleanup-remote-linked/thumbnail.png',
	mimeType: 'image/png',
	width: 800,
	height: 600,
	byteSize: 1234,
	altText: null,
	createdAt: Time::parse('2026-01-01T00:00:00Z'),
);
$freshAttachment = new Attachment(
	id: 'cleanup-fresh',
	ownerId: 'alice',
	storageKey: 'media/cleanup-fresh/original.png',
	thumbnailKey: 'media/cleanup-fresh/thumbnail.png',
	mimeType: 'image/png',
	width: 800,
	height: 600,
	byteSize: 1234,
	altText: null,
	createdAt: Time::parse('2026-03-02T00:00:00Z'),
);
foreach ([$oldAttachment, $linkedAttachment, $remoteLinkedAttachment, $freshAttachment] as $attachment) {
	$cleanupAttachments->insert($attachment);
	$cleanupBlobs->put($attachment->storageKey, 'original');
	$cleanupBlobs->put($attachment->thumbnailKey, 'thumbnail');
}
$cleanupRemotePosts->insert(new RemotePost(
	activityId: 'https://remote.example/activities/cleanup',
	objectId: 'https://remote.example/notes/cleanup',
	actorId: 'https://remote.example/users/bob',
	kind: RemotePostKind::Post,
	content: 'remote post with a shared image',
	contentWarning: null,
	publishedAt: Time::parse('2026-01-01T00:00:00Z'),
	objectAuthorId: 'https://remote.example/users/bob',
));
$cleanupRemotePosts->linkAttachments('https://remote.example/activities/cleanup', ['cleanup-remote-linked']);
$cleanupPosts->insert(new Post(
	id: 'cleanup-post',
	authorId: 'alice',
	content: 'linked media stays',
	visibility: Visibility::Public,
	publishedAt: Time::parse('2026-01-01T00:00:00Z'),
	attachmentIds: ['cleanup-linked'],
));
$cleanupNotifications->insert(new Notification(
	id: 'cleanup-old-read',
	recipientId: 'alice',
	actorId: 'bob',
	type: NotificationType::Follow,
	postId: null,
	createdAt: Time::parse('2026-01-01T00:00:00Z'),
	readAt: Time::parse('2026-01-01T00:00:00Z'),
));
$cleanupNotifications->insert(new Notification(
	id: 'cleanup-old-unread',
	recipientId: 'alice',
	actorId: 'bob',
	type: NotificationType::Follow,
	postId: null,
	createdAt: Time::parse('2026-01-01T00:00:00Z'),
));
$cleanupNotifications->insert(new Notification(
	id: 'cleanup-fresh-read',
	recipientId: 'alice',
	actorId: 'bob',
	type: NotificationType::Follow,
	postId: null,
	createdAt: Time::parse('2026-03-02T00:00:00Z'),
	readAt: Time::parse('2026-03-02T00:00:00Z'),
));
$cleanupThreads->upsert(new RemoteThreadPost(
	objectId: 'https://remote.example/notes/cleanup-old',
	authorId: 'https://remote.example/users/bob',
	content: 'expired cached node',
	publishedAt: Time::parse('2026-01-01T00:00:00Z'),
	fetchedAt: Time::parse('2026-01-01T00:00:00Z'),
));
$cleanupThreads->upsert(new RemoteThreadPost(
	objectId: 'https://remote.example/notes/cleanup-fresh',
	authorId: 'https://remote.example/users/bob',
	content: 'fresh cached node',
	publishedAt: Time::parse('2026-03-02T00:00:00Z'),
	fetchedAt: Time::parse('2026-03-02T00:00:00Z'),
));

$transactionDatabase = new PdoConnection(new PDO('sqlite::memory:'));
PostSchema::create($transactionDatabase);
PollSchema::create($transactionDatabase);
AttachmentSchema::create($transactionDatabase);
NotificationSchema::create($transactionDatabase);
JobSchema::create($transactionDatabase);

$transactionConfig = new ArrayConfig([
	'social' => [
		'instance.url' => 'https://social.example',
		'instance.name' => 'Aloha Social SQLite demo',
	],
]);
$transactionKey = RsaKeyPair::generate();
$transactionClock = new FrozenClock(Time::parse('2026-11-11T10:00:00Z'));
$transactionQueue = new PdoJobQueue($transactionDatabase, $transactionClock, new RandomIdGenerator());
$demoInboxes = new class implements InboxResolver {
	public function inboxesFor(string $actorId): array
	{
		return ['https://remote.example/users/bob/inbox'];
	}
};

$sqlApp = Application::forHost(
	config: $transactionConfig,
	database: $transactionDatabase,
	httpClient: new CurlHttpClient(),
	signingKey: $transactionKey,
	localActors: new InMemoryActorDirectory(['alice']),
	queue: $transactionQueue,
	activityLog: new PdoActivityLog($transactionDatabase),
	inboxResolver: $demoInboxes,
	clock: $transactionClock,
);

$rollbackApp = Application::forHost(
	config: $transactionConfig,
	database: $transactionDatabase,
	httpClient: new CurlHttpClient(),
	signingKey: $transactionKey,
	localActors: new InMemoryActorDirectory(['alice']),
	queue: new DemoRejectingQueue(),
	activityLog: new PdoActivityLog($transactionDatabase),
	inboxResolver: $demoInboxes,
	clock: $transactionClock,
);

$postCount = static fn (): int => (int) $transactionDatabase->fetchValue('SELECT COUNT(*) FROM ' . PostSchema::TABLE);
$hashtagCount = static fn (): int => (int) $transactionDatabase->fetchValue('SELECT COUNT(*) FROM ' . PostSchema::HASHTAG_TABLE);

$beforePost = $postCount();
$beforeHashtag = $hashtagCount();
$beforeJobs = $transactionQueue->pendingCount();

echo "SQLite transaction demo\n";
call($sqlApp, 'POST /api/v1/posts (committed)', new Request(
	method: 'POST',
	path: '/api/v1/posts',
	headers: ['Content-Type' => 'application/json'],
	body: json_encode([
		'content' => 'Committed with its #transaction side rows.',
		'visibility' => 'public',
	], JSON_THROW_ON_ERROR),
	userId: 'alice',
));

$afterCommitPost = $postCount();
$afterCommitHashtag = $hashtagCount();
$afterCommitJobs = $transactionQueue->pendingCount();
if ($afterCommitPost !== $beforePost + 1
	|| $afterCommitHashtag !== $beforeHashtag + 1
	|| $afterCommitJobs !== $beforeJobs + 1
) {
	fwrite(STDERR, "demo failed: the successful post did not commit its post, hashtag and job\n");
	exit(1);
}

call($rollbackApp, 'POST /api/v1/posts (queue failure)', new Request(
	method: 'POST',
	path: '/api/v1/posts',
	headers: ['Content-Type' => 'application/json'],
	body: json_encode([
		'content' => 'This post and its #transaction rows must roll back.',
		'visibility' => 'public',
	], JSON_THROW_ON_ERROR),
	userId: 'alice',
));

if ($postCount() !== $afterCommitPost || $hashtagCount() !== $afterCommitHashtag) {
	fwrite(STDERR, "demo failed: the rejected post left rows behind\n");
	exit(1);
}

echo "rollback ok: posts ", $beforePost, " -> ", $afterCommitPost, " -> ", $postCount(),
	", hashtags ", $beforeHashtag, " -> ", $afterCommitHashtag, " -> ", $hashtagCount(),
	", queued jobs ", $beforeJobs, " -> ", $afterCommitJobs, " -> ", $transactionQueue->pendingCount(), "\n\n";

$cleanupApp = Application::inMemory(
	clock: $cleanupClock,
	attachmentRepository: $cleanupAttachments,
	remotePostRepository: $cleanupRemotePosts,
	notificationRepository: $cleanupNotifications,
	remoteThreadRepository: $cleanupThreads,
	blobStore: $cleanupBlobs,
	localActors: new InMemoryActorDirectory(['alice']),
);

if ($cleanupApp->cleanup === null) {
	fwrite(STDERR, "demo failed: cleanup service is not wired\n");
	exit(1);
}

$cleanupOptions = new CleanupOptions(
	kind: CleanupOptions::KIND_ALL,
	mediaRetentionDays: 30,
	notificationRetentionDays: 30,
	threadRetentionDays: 30,
	limit: 100,
);
$preview = $cleanupApp->cleanup->run(new CleanupOptions(
	kind: $cleanupOptions->kind,
	mediaRetentionDays: $cleanupOptions->mediaRetentionDays,
	notificationRetentionDays: $cleanupOptions->notificationRetentionDays,
	threadRetentionDays: $cleanupOptions->threadRetentionDays,
	limit: $cleanupOptions->limit,
	dryRun: true,
));
echo "cleanup preview: ", json_encode($preview->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n\n";

$cleanupApp->queue->push(JobType::CLEANUP, $cleanupOptions->toArray());
$cleanupApp->worker->runOnce();

$after = $cleanupApp->cleanup->run(new CleanupOptions(
	kind: $cleanupOptions->kind,
	mediaRetentionDays: $cleanupOptions->mediaRetentionDays,
	notificationRetentionDays: $cleanupOptions->notificationRetentionDays,
	threadRetentionDays: $cleanupOptions->threadRetentionDays,
	limit: $cleanupOptions->limit,
	dryRun: true,
));

if ($preview->matched() !== 3 || $cleanupApp->queue->pendingCount() !== 0 || $after->matched() !== 0) {
	fwrite(STDERR, "demo failed: cleanup preview/job did not remove exactly the expired rows\n");
	exit(1);
}
if ($cleanupAttachments->find('cleanup-old') !== null
	|| $cleanupAttachments->find('cleanup-linked') === null
	|| $cleanupAttachments->find('cleanup-remote-linked') === null
	|| $cleanupAttachments->find('cleanup-fresh') === null
) {
	fwrite(STDERR, "demo failed: media cleanup removed a linked or fresh attachment\n");
	exit(1);
}
if ($cleanupNotifications->find('cleanup-old-read') !== null
	|| $cleanupNotifications->find('cleanup-old-unread') === null
	|| $cleanupNotifications->find('cleanup-fresh-read') === null
) {
	fwrite(STDERR, "demo failed: notification cleanup removed an unread or fresh row\n");
	exit(1);
}
if ($cleanupThreads->find('https://remote.example/notes/cleanup-old') !== null
	|| $cleanupThreads->find('https://remote.example/notes/cleanup-fresh') === null
) {
	fwrite(STDERR, "demo failed: thread cleanup removed a fresh cache node\n");
	exit(1);
}
if ($cleanupBlobs->exists($oldAttachment->storageKey)
	|| $cleanupBlobs->exists($oldAttachment->thumbnailKey)
	|| !$cleanupBlobs->exists($linkedAttachment->storageKey)
	|| !$cleanupBlobs->exists($remoteLinkedAttachment->storageKey)
	|| !$cleanupBlobs->exists($freshAttachment->storageKey)
) {
	fwrite(STDERR, "demo failed: media blobs do not match the cleanup result\n");
	exit(1);
}

echo "cleanup ok: 3 expired rows (media, notification, thread cache) removed; local/remote-linked, fresh and unread rows kept\n";
echo "demo ok: ", count($posts), " post(s) on the public timeline, ", count($followedPosts), " on the followed hashtag timeline\n";
